# Copy this file to ".env" (next to docker-compose.yml) and fill it in.
# .env holds secrets: don't share it or put it in git.
# No spaces around "=". If a value has # or spaces, wrap it in single quotes: 'a#b c'.

# ---------- Required ----------

# The shared SQL Server's sa password: the same value as SQL_SA_PASSWORD in shared-sql's .env. Only db-deploy uses it,
# to create the Ludex database and the ludex login.
SQL_SA_PASSWORD=Change-Me-2026!

# The password of the ludex login, which the WebApi connects with (it only sees the Ludex database). Make up a new one:
# letters and numbers, 20+ characters (in bash:  echo "Aa1$(LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 24)").
# db-deploy creates the login, and sets this password again on every deploy, so changing it here is all it takes.
SQL_APP_PASSWORD=change-this-to-a-long-random-password

# Internal key between the website and the WebApi. Another long random string.
LUDEX_API_KEY=change-this-to-a-long-random-key

# Asked for only when creating the FIRST account (the admin), so nobody else on the network can create it before you.
LUDEX_SETUP_KEY=change-this

# ---------- The game catalog (recommended) ----------

# IGDB, through a free Twitch application: https://dev.twitch.tv/console/apps → Register Your Application
# (name: anything, OAuth Redirect URL: http://localhost, category: Application Integration, client type: Confidential),
# then "Manage" → copy the Client ID and press "New Secret". Empty: Ludex uses its short built-in list, without images.
# IGDB_CLIENT_ID=
# IGDB_CLIENT_SECRET=

# ---------- Steam import (optional) ----------

# Lets everyone import their Steam library (Settings → Import from Steam): games, hours played, last played.
# Get a free key at https://steamcommunity.com/dev/apikey (domain: anything, e.g. ludex.local). Needs IGDB too, to
# match the games. Each person's Steam profile must have "Game details" set to Public.
# STEAM_API_KEY=

# ---------- Optional ----------

# The shared SQL Server's container name, on the sql-net network.
# SQL_SERVER=shared-sql

# false = after the first account, nobody can create one from the sign-in page.
# LUDEX_ALLOW_REGISTRATION=true

# TIME_ZONE=Europe/Lisbon
# LUDEX_PORT=5098
# LUDEX_CPUS=1
# LUDEX_WEBAPI_MEMORY=384m
# LUDEX_WEBSITE_MEMORY=384m
