<Project Sdk="Microsoft.Build.Sql/2.1.0">

  <!-- SQL Server database of Ludex: the tables and the stored procedures the WebApi calls. Builds to Ludex.Database.dacpac,
       which the db-deploy container publishes on every deploy (creates the database or brings it up to date) and which
       also creates the app's own login (AppUser / AppPassword), so the WebApi never connects as sa.
       Every script is listed below (no wildcards), so Visual Studio shows them with either SSDT flavour;
       adding a script through Solution Explorer adds its line here. -->
  <PropertyGroup>
    <Name>Ludex.Database</Name>
    <DSP>Microsoft.Data.Tools.Schema.Sql.Sql160DatabaseSchemaProvider</DSP>
    <ModelCollation>1033, CI</ModelCollation>
    <DefaultCollation>SQL_Latin1_General_CP1_CI_AS</DefaultCollation>
    <TargetDatabaseSet>True</TargetDatabaseSet>
    <EnableDefaultSqlItems>false</EnableDefaultSqlItems>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Tables\" />
    <Folder Include="StoredProcedures\" />
    <Folder Include="StoredProcedures\Activity\" />
    <Folder Include="StoredProcedures\Friends\" />
    <Folder Include="StoredProcedures\Games\" />
    <Folder Include="StoredProcedures\Library\" />
    <Folder Include="StoredProcedures\Users\" />
    <Folder Include="StoredProcedures\Profile\" />
    <Folder Include="StoredProcedures\Collections\" />
    <Folder Include="StoredProcedures\Notifications\" />
    <Folder Include="StoredProcedures\Prices\" />
    <Folder Include="StoredProcedures\Steam\" />
    <Folder Include="Scripts\" />
  </ItemGroup>

  <ItemGroup>
    <Build Include="Tables\dbo.Activity.sql" />
    <Build Include="Tables\dbo.Friendship.sql" />
    <Build Include="Tables\dbo.Game.sql" />
    <Build Include="Tables\dbo.LibraryEntry.sql" />
    <Build Include="Tables\dbo.Profile.sql" />
    <Build Include="Tables\dbo.User.sql" />
    <Build Include="StoredProcedures\Activity\dbo.ActivityAdd.sql" />
    <Build Include="StoredProcedures\Activity\dbo.ActivityFeed.sql" />
    <Build Include="StoredProcedures\Friends\dbo.FriendAccept.sql" />
    <Build Include="StoredProcedures\Friends\dbo.FriendGameList.sql" />
    <Build Include="StoredProcedures\Friends\dbo.FriendList.sql" />
    <Build Include="StoredProcedures\Friends\dbo.FriendOwnership.sql" />
    <Build Include="StoredProcedures\Friends\dbo.FriendPopular.sql" />
    <Build Include="StoredProcedures\Friends\dbo.FriendRemove.sql" />
    <Build Include="StoredProcedures\Friends\dbo.FriendRequest.sql" />
    <Build Include="StoredProcedures\Games\dbo.GameCoverWall.sql" />
    <Build Include="StoredProcedures\Games\dbo.GameGet.sql" />
    <Build Include="StoredProcedures\Games\dbo.GameUpsert.sql" />
    <Build Include="StoredProcedures\Library\dbo.LibraryDelete.sql" />
    <Build Include="StoredProcedures\Library\dbo.LibraryGet.sql" />
    <Build Include="StoredProcedures\Library\dbo.LibraryList.sql" />
    <Build Include="StoredProcedures\Library\dbo.LibrarySave.sql" />
    <Build Include="StoredProcedures\Profile\dbo.ProfileAvatarGet.sql" />
    <Build Include="StoredProcedures\Profile\dbo.ProfileAvatarSave.sql" />
    <Build Include="StoredProcedures\Profile\dbo.ProfileFriends.sql" />
    <Build Include="StoredProcedures\Profile\dbo.ProfileGet.sql" />
    <Build Include="StoredProcedures\Profile\dbo.ProfileSave.sql" />
    <Build Include="StoredProcedures\Profile\dbo.ProfileSetAccent.sql" />
    <Build Include="StoredProcedures\Profile\dbo.ProfileSetFavorite.sql" />
    <Build Include="StoredProcedures\Profile\dbo.ProfileTouch.sql" />
    <Build Include="StoredProcedures\Profile\dbo.ProfileSetSteam.sql" />
    <Build Include="StoredProcedures\Library\dbo.LibraryImport.sql" />
    <Build Include="StoredProcedures\Collections\dbo.CollectionDelete.sql" />
    <Build Include="StoredProcedures\Collections\dbo.CollectionList.sql" />
    <Build Include="StoredProcedures\Collections\dbo.CollectionSave.sql" />
    <Build Include="StoredProcedures\Collections\dbo.CollectionSetGame.sql" />
    <Build Include="StoredProcedures\Games\dbo.GameStaleList.sql" />
    <Build Include="StoredProcedures\Notifications\dbo.NotificationAdd.sql" />
    <Build Include="StoredProcedures\Notifications\dbo.NotificationList.sql" />
    <Build Include="StoredProcedures\Notifications\dbo.NotificationRead.sql" />
    <Build Include="StoredProcedures\Notifications\dbo.NotificationUnread.sql" />
    <Build Include="StoredProcedures\Prices\dbo.PriceSave.sql" />
    <Build Include="StoredProcedures\Prices\dbo.PriceTargetSet.sql" />
    <Build Include="StoredProcedures\Prices\dbo.PriceTargets.sql" />
    <Build Include="StoredProcedures\Steam\dbo.AchievementSave.sql" />
    <Build Include="StoredProcedures\Steam\dbo.AchievementTargets.sql" />
    <Build Include="StoredProcedures\Steam\dbo.SteamAccountList.sql" />
    <Build Include="StoredProcedures\Steam\dbo.SteamOwnedList.sql" />
    <Build Include="StoredProcedures\Steam\dbo.SteamOwnedRemember.sql" />
    <Build Include="Tables\dbo.Collection.sql" />
    <Build Include="Tables\dbo.CollectionGame.sql" />
    <Build Include="Tables\dbo.GamePrice.sql" />
    <Build Include="Tables\dbo.Notification.sql" />
    <Build Include="Tables\dbo.PlaytimeDay.sql" />
    <Build Include="Tables\dbo.SteamOwned.sql" />
    <Build Include="StoredProcedures\Users\dbo.UserCount.sql" />
    <Build Include="StoredProcedures\Users\dbo.UserCreate.sql" />
    <Build Include="StoredProcedures\Users\dbo.UserDelete.sql" />
    <Build Include="StoredProcedures\Users\dbo.UserGet.sql" />
    <Build Include="StoredProcedures\Users\dbo.UserGetByName.sql" />
    <Build Include="StoredProcedures\Users\dbo.UserList.sql" />
    <Build Include="StoredProcedures\Users\dbo.UserSetPassword.sql" />
    <Build Include="StoredProcedures\Users\dbo.UserTouchLogin.sql" />
  </ItemGroup>

  <ItemGroup>
    <PostDeploy Include="Scripts\Script.PostDeployment.sql" />
    <None Include="Scripts\deploy.sh" />
    <None Include="Dockerfile" />
  </ItemGroup>

  <!-- The login the WebApi connects with. deploy.sh passes both (/v:AppUser=… /v:AppPassword=…); an empty password skips it. -->
  <ItemGroup>
    <SqlCmdVariable Include="AppUser">
      <DefaultValue>ludex</DefaultValue>
      <Value>$(SqlCmdVar__1)</Value>
    </SqlCmdVariable>
    <SqlCmdVariable Include="AppPassword">
      <DefaultValue></DefaultValue>
      <Value>$(SqlCmdVar__2)</Value>
    </SqlCmdVariable>
  </ItemGroup>

</Project>
