@model ShelfCard
@* One game on a home shelf: a clean cover, the name (with a score or a sale beside it) and a line about it. *@
@{
    var entry = Model.Entry;
    var game = entry.Game;
}
<a class="shelf-card" href="/games/@game.Id" aria-label="@game.Name" draggable="true" data-drag-game="@game.Id">
    <span class="shelf-cover">
        <partial name="_Cover" model="new CoverView(game, Model.Transition)" />
    </span>
    <span class="shelf-line">
        <span class="shelf-name">@game.Name</span>
        @if (Model.Chip is not null)
        {
            <span class="shelf-score @Model.ChipCss">@Model.Chip</span>
        }
    </span>
    @if (!string.IsNullOrEmpty(Model.Sub))
    {
        <span class="shelf-sub">@Model.Sub</span>
    }
</a>
