@model LibrarySidebarView
@* The library down the side, as on Steam: a filter, your collections (drop a game on one to put it there), then
   every game by status. Groups start closed except Playing (and the one with the game you're on); app.js remembers
   the ones you open. Stays put between the library and the game pages (app.js keeps its scroll position). *@
@{
    var groups = new[] { GameStatus.Playing, GameStatus.Backlog, GameStatus.Finished, GameStatus.Played, GameStatus.Wishlist, GameStatus.Dropped };
    var byId = Model.Entries.GroupBy(static e => e.Game.Id).ToDictionary(static g => g.Key, static g => g.First());
    var several = Model.Entries.GroupBy(static e => e.Game.Id).Where(static g => g.Count() > 1).Select(static g => g.Key).ToHashSet();
}
<aside class="lib-side" data-lib-side aria-label="Your library">
    <a class="lib-side-home" href="/library" aria-current="@(Model.Current is null && !Model.AtHome ? "page" : null)">
        @Icons.Get("library")<span>Library</span><b>@Model.Entries.Count</b>
    </a>
    <label class="lib-side-search">
        <span class="sr-only">Find in your library</span>
        @Icons.Get("search")
        <input type="search" placeholder="Search your games" autocomplete="off" data-side-filter />
    </label>
    <nav class="lib-side-groups">
        <div class="lib-side-head">
            <span>Collections</span>
            <button type="button" class="icon-btn mini" data-new-collection aria-label="New collection" title="New collection">@Icons.Get("plus")</button>
        </div>
        <form class="lib-new-col" hidden data-new-collection-form autocomplete="off">
            <input type="text" name="name" maxlength="60" placeholder="Name, then Enter" aria-label="New collection's name" />
        </form>
        @if (Model.Collections.Count == 0)
        {
            <p class="lib-side-hint" data-collections-hint>Make one with +, then drag games onto it.</p>
        }
        @foreach (var collection in Model.Collections)
        {
            var games = collection.GameIds.Select(id => byId.GetValueOrDefault(id)).OfType<LibraryEntryDTO>()
                .OrderBy(static e => e.Game.Name, StringComparer.OrdinalIgnoreCase).ToList();
            var colOpen = Model.Current is { } cur && games.Any(g => g.Game.Id == cur);
            <details class="lib-group lib-col" open="@(colOpen ? "open" : null)" data-drop-collection="@collection.Id">
                <summary><span>@collection.Name</span><small><span data-col-count>@games.Count</span></small><a class="lib-col-open" href="/library?collection=@collection.Id" aria-label="Show @collection.Name">@Icons.Get("right")</a></summary>
                <ul>
                    @foreach (var entry in games)
                    {
                        @LibraryHtml.SideItem(entry, Model.Current, several.Contains(entry.Game.Id))
                    }
                </ul>
            </details>
        }

        @foreach (var status in groups)
        {
            var games = Model.Entries.Where(e => e.Status == status).OrderBy(static e => e.Game.Name, StringComparer.OrdinalIgnoreCase).ToList();
            if (games.Count == 0)
            {
                continue;
            }

            var groupOpen = status == GameStatus.Playing || (Model.Current is { } here && games.Any(g => g.Game.Id == here));
            <details class="lib-group" open="@(groupOpen ? "open" : null)" data-lib-group="@status">
                <summary><span>@Fmt.Status(status)</span><small>@games.Count</small></summary>
                <ul>
                    @foreach (var entry in games)
                    {
                        @LibraryHtml.SideItem(entry, Model.Current, several.Contains(entry.Game.Id))
                    }
                </ul>
            </details>
        }
    </nav>
</aside>
