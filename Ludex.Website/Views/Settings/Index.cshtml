@model SettingsPageModel
@{
    Layout = "_App";
    ViewData["Title"] = "Settings";
    var igdb = Model.Health?.Source == CatalogSource.Igdb;
    var accent = Ludex.Website.Security.LudexAuthentication.Accent(User);
}

<div class="settings">
    <h1 class="rise">Settings</h1>

    <section class="panel rise">
        <div class="me-card">
            @Avatars.Get(Model.MyId, Model.UserName, Model.MyAvatarVersion, "big")
            <div>
                <b>@Model.UserName</b>
                <small class="muted">@(Model.IsAdmin ? "Admin" : "Member") · friends find you by this name</small>
            </div>
            <a class="btn ghost small push" href="/profile/edit">@Icons.Get("edit")Customize profile</a>
            <form method="post" action="/sign-out">
                @Html.AntiForgeryToken()
                <button class="btn ghost small" type="submit">@Icons.Get("logout")Sign out</button>
            </form>
        </div>
    </section>

    <section class="panel rise d1">
        <h2>Appearance</h2>
        <p class="muted">The colour of buttons, bars and highlights. It follows your account to every device.</p>
        <div class="swatches" role="radiogroup" aria-label="Colour theme" data-accents>
            @foreach (var theme in Ludex.Library.Themes.Accents.All)
            {
                var on = theme.Key == accent;
                <button type="button" class="swatch" role="radio" aria-checked="@(on ? "true" : "false")" data-accent-pick="@theme.Key" style="--sw: @theme.Color">
                    <span class="swatch-dot" aria-hidden="true"></span><span>@theme.Name</span>
                </button>
            }
        </div>
    </section>

    <section class="panel rise d1 steam-card">
        <span class="empty-ico" aria-hidden="true">@Icons.Get("pad")</span>
        <div>
            <h2>Steam</h2>
            <p class="muted">Bring in your Steam games with their hours. Come back any time to sync the hours again.</p>
        </div>
        <a class="btn" href="/steam">@Icons.Get("arrow")Import from Steam</a>
    </section>

    <section class="panel rise d1 steam-card">
        <span class="empty-ico" aria-hidden="true">@Icons.Get("trophy")</span>
        <div>
            <h2>PlayStation</h2>
            <p class="muted">Connect your PlayStation account: PS5 and PS4 games with their hours, PS3 and PS Vita games through their trophies, synced every day.</p>
        </div>
        <a class="btn" href="/psn">@Icons.Get("arrow")Connect PlayStation</a>
    </section>

    <section class="panel rise d1 steam-card">
        <span class="empty-ico" aria-hidden="true">@Icons.Get("library")</span>
        <div>
            <h2>Playnite</h2>
            <p class="muted">Epic, GOG, EA app, Ubisoft Connect, Battle.net, Xbox, emulators: export your Playnite library and bring it all in, with hours and stores.</p>
        </div>
        <a class="btn" href="/playnite">@Icons.Get("arrow")Import from Playnite</a>
    </section>

    @if (Model.DiscordEnabled)
    {
        <section class="panel rise d1 discord-card" id="discord">
            <span class="empty-ico" aria-hidden="true"><span class="discord-mark" aria-hidden="true"></span></span>
            <div>
                <h2>Discord</h2>
                @if (Model.DiscordLinked)
                {
                    <p class="muted">Linked to <b>@(Model.DiscordName ?? "your Discord account")</b>. "Sign in with Discord" opens this account@(Model.HasPassword ? "; your password still works too." : ". It's the only way in until you set a password below.")</p>
                }
                else
                {
                    <p class="muted">Link your Discord account to sign in with it instead of your password. Nothing in your library changes.</p>
                }
                @switch (Model.DiscordNote)
                {
                    case "linked":
                        <p class="note ok">Discord is linked. Next time, use "Sign in with Discord".</p>
                        break;
                    case "unlinked":
                        <p class="note">Discord is unlinked. Sign in with your password.</p>
                        break;
                    case "taken":
                        <p class="note err">That Discord account is already linked to another account here.</p>
                        break;
                    case "failed":
                        <p class="note err">Discord didn't finish. Try again.</p>
                        break;
                    case "needs-password":
                        <p class="note err">Discord is the only way into this account. Set a password below before unlinking it.</p>
                        break;
                }
            </div>
            @* Without a password, unlinking would lock the account: the button waits for one. *@
            @if (Model.DiscordLinked && Model.HasPassword)
            {
                <form method="post" action="/settings/discord/unlink">
                    @Html.AntiForgeryToken()
                    <button class="btn ghost" type="submit">Unlink</button>
                </form>
            }
            else if (!Model.DiscordLinked)
            {
                <form method="post" action="/settings/discord">
                    @Html.AntiForgeryToken()
                    <button class="btn discord-btn" type="submit"><span class="discord-mark" aria-hidden="true"></span>Link Discord</button>
                </form>
            }
        </section>
    }

    <section class="panel rise d1">
        <h2>@(Model.HasPassword ? "Password" : "Set a password")</h2>
        <form class="stack" method="post" action="/settings/password" autocomplete="off">
            @Html.AntiForgeryToken()
            @if (Model.HasPassword)
            {
                <label class="field"><span class="label">Current password</span><input name="currentPassword" type="password" autocomplete="current-password" required /></label>
            }
            else
            {
                <p class="muted">You signed up with Discord. Add a password to sign in with your user name too.</p>
            }
            <div class="two">
                <label class="field"><span class="label">New password</span><input name="newPassword" type="password" autocomplete="new-password" minlength="8" required /></label>
                <label class="field"><span class="label">New password again</span><input name="confirmPassword" type="password" autocomplete="new-password" minlength="8" required /></label>
            </div>
            <button class="btn" type="submit">@(Model.HasPassword ? "Change password" : "Set password")</button>
        </form>
    </section>

    <section class="panel rise d2">
        <h2>Game catalog</h2>
        @if (igdb)
        {
            <p class="status-line"><span class="dot on"></span>IGDB: every game, with covers, art and screenshots.</p>
        }
        else
        {
            <p class="status-line"><span class="dot"></span>The short built-in list (no images).</p>
            <p class="muted">For the full catalog, create a free application at <a href="https://dev.twitch.tv/console/apps" rel="noopener" target="_blank">dev.twitch.tv</a> (any name, redirect URL <code>http://localhost</code>, category “Application Integration”), then put its Client ID and a new Client Secret in <code>.env</code> as <code>IGDB_CLIENT_ID</code> and <code>IGDB_CLIENT_SECRET</code>, and update Ludex.</p>
        }
    </section>

    <section class="panel rise d2 danger-zone" id="clear">
        <h2>Clear your library</h2>
        <p class="muted">Takes every game out of your library, with its status, rating, hours, notes and activity, and empties your collections (they stay, empty), so you can import from Steam, PlayStation and Playnite again from scratch. Your account, friends, profile and the Steam and PlayStation connections stay. This can't be undone.</p>
        <details class="clear-confirm">
            <summary class="btn ghost danger-btn">@Icons.Get("trash")Clear library…</summary>
            <form class="stack" method="post" action="/library/clear" autocomplete="off">
                @Html.AntiForgeryToken()
                <label class="field">
                    <span class="label">Type your user name, <b>@Model.UserName</b>, to confirm</span>
                    <input name="confirm" type="text" autocapitalize="none" spellcheck="false" required />
                </label>
                <button class="btn danger-btn" type="submit">@Icons.Get("trash")Clear my library</button>
            </form>
        </details>
    </section>

    @if (Model.IsAdmin && Model.Users.Count > 0)
    {
        <section class="panel">
            <h2>Accounts</h2>
            <ul class="people">
                @foreach (var user in Model.Users)
                {
                    <li class="person">
                        @Avatars.Get(user.Id, user.UserName, user.AvatarVersion)
                        <span class="person-text"><b>@user.UserName</b><small>@(user.Role == UserRole.Admin ? "Admin" : "Member") · @(user.LastSignInAt is { } at ? "last seen " + Fmt.Ago(at) : "never signed in")</small></span>
                        @if (user.Id != Model.UserId)
                        {
                            <form method="post" action="/settings/delete-user" class="person-acts" data-confirm="Delete @user.UserName and their whole library? This can't be undone.">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@user.Id" />
                                <button class="icon-btn" type="submit" aria-label="Delete @user.UserName" title="Delete">@Icons.Get("trash")</button>
                            </form>
                        }
                    </li>
                }
            </ul>
        </section>
    }

    <p class="muted version">@AppPageModel.ProductName @AppPageModel.CurrentVersion · <a href="https://github.com/rodrigocoelho2/Ludex" rel="noopener" target="_blank">GitHub</a></p>
</div>
