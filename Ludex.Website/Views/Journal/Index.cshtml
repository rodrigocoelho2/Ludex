@model JournalPageModel
@{
    Layout = "_App";
    ViewData["Title"] = "Journal";
    var j = Model.Journal;
    var first = Model.First;
    var days = DateTime.DaysInMonth(first.Year, first.Month);
    var lead = ((int)first.DayOfWeek + 6) % 7;   // Monday first
    var cells = (int)Math.Ceiling((lead + days) / 7.0) * 7;
    var byDay = Model.ByDay;
    var prev = first.AddMonths(-1);
    var next = first.AddMonths(1);
    var english = System.Globalization.CultureInfo.GetCultureInfo("en-IE");
    var colours = new[] { "#4FC3F7", "#F5B841", "#B39DFF", "#7EE0A1", "#FF8A80", "#F472B6", "#34D399", "#FB923C" };
    var colourOf = j.Games.Select((g, i) => (g.Game.Id, Colour: colours[i % colours.Length])).ToDictionary(static x => x.Id, static x => x.Colour);
    var picked = byDay[Model.Day].ToList();
    var top = Math.Max(1, j.Games.Select(static g => g.Minutes).DefaultIfEmpty(0).Max());
    var isThisMonth = Model.Today.Year == first.Year && Model.Today.Month == first.Month;
}

<div class="jr">
    <div class="page-head rise">
        <div>
            <h1>Journal</h1>
            <p class="muted">
                @if (j.Sessions == 0)
                {
                    <text>Nothing in @first.ToString("MMMM", english) yet. Log a session below, or let the Steam and PlayStation syncs fill it in.</text>
                }
                else
                {
                    <text><b class="soft">@Fmt.Minutes(j.Minutes)</b> across <b class="soft">@Fmt.Plural(j.Sessions, "session", "sessions")</b> and <b class="soft">@Fmt.Plural(j.Games.Count, "game", "games")</b> in @first.ToString("MMMM", english)</text>
                    @if (j.Streak > 1) { <text> · <b class="gold">@j.Streak days</b> in a row</text> }
                }
            </p>
        </div>
        <nav class="jr-month" aria-label="Month">
            <a class="icon-btn" href="/journal?month=@prev.ToString("yyyy-MM", english)" aria-label="@prev.ToString("MMMM yyyy", english)">@Icons.Get("left")</a>
            <b class="num">@first.ToString("MMMM yyyy", english)</b>
            <a class="icon-btn" href="/journal?month=@next.ToString("yyyy-MM", english)" aria-label="@next.ToString("MMMM yyyy", english)" hidden="@(next > Model.Today ? "hidden" : null)">@Icons.Get("right")</a>
        </nav>
    </div>

    <div class="split jr-split">
        <section class="split-main jr-cal panel rise d1" aria-label="Calendar">
            <div class="jr-week" aria-hidden="true"><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span></div>
            <div class="jr-grid">
                @for (var c = 0; c < cells; c++)
                {
                    var n = c - lead + 1;
                    if (n < 1 || n > days)
                    {
                        <span class="jr-day out" aria-hidden="true"></span>
                        continue;
                    }

                    var day = new DateOnly(first.Year, first.Month, n);
                    var lines = byDay[day].ToList();
                    var minutes = lines.Sum(static l => l.Minutes);
                    var css = "jr-day" + (lines.Count > 0 ? " has" : string.Empty) + (day == Model.Day ? " on" : string.Empty) + (day == Model.Today ? " today" : string.Empty) + (day > Model.Today ? " later" : string.Empty);
                    <a class="@css" href="/journal?month=@first.ToString("yyyy-MM", english)&day=@day.ToString("yyyy-MM-dd", english)" aria-current="@(day == Model.Day ? "date" : null)" aria-label="@day.ToString("d MMMM", english)@(minutes > 0 ? ", " + Fmt.Minutes(minutes) : string.Empty)">
                        <b>@n</b>
                        <span class="jr-dots">@foreach (var g in lines.Select(static l => l.Game.Id).Distinct()) { <i style="background:@colourOf.GetValueOrDefault(g, "#9FB0C3")"></i> }</span>
                        @if (minutes > 0) { <small>@Fmt.Minutes(minutes)</small> }
                    </a>
                }
            </div>
        </section>

        <aside class="split-side jr-side">
            <section class="rise d1" aria-labelledby="day-h">
                <h2 id="day-h">@Model.Day.ToString("dddd, d MMMM", english)@(Model.Day == Model.Today ? " · today" : string.Empty)</h2>
                @if (picked.Count == 0)
                {
                    <p class="muted small-empty">Nothing on this day.</p>
                }
                <ul class="jr-lines">
                    @foreach (var line in picked)
                    {
                        <li class="jr-line" style="--c:@colourOf.GetValueOrDefault(line.Game.Id, "#9FB0C3")">
                            <a class="feed-thumb tall" href="/games/@line.Game.Id" style="--tint:@line.Game.Tint" aria-label="@line.Game.Name">@if (line.Game.CoverImageId is { } cover) { <img src="@Igdb.Url(cover, Igdb.CoverSmall)" alt="" loading="lazy" decoding="async" /> }</a>
                            <div class="jr-line-text">
                                <div class="jr-line-top"><a href="/games/@line.Game.Id"><b>@line.Game.Name</b></a><b class="num">@Fmt.Minutes(line.Minutes)</b></div>
                                <small class="muted">@(line.Source == SessionSource.Sync ? "Seen by the sync" : "Written down")@(line.Platform is { } p ? " · " + p : string.Empty)</small>
                                @if (line.Note is { } note) { <p>@note</p> }
                            </div>
                            @if (line.Id is { } id)
                            {
                                <form method="post" action="/journal/session/@id/delete">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="back" value="/journal?month=@first.ToString("yyyy-MM", english)&day=@Model.Day.ToString("yyyy-MM-dd", english)" />
                                    <button type="submit" class="icon-btn mini" aria-label="Take this session out">@Icons.Get("trash")</button>
                                </form>
                            }
                        </li>
                    }
                </ul>

                @if (Model.Day <= Model.Today && Model.Games.Count > 0)
                {
                    <form class="jr-add panel" method="post" action="/journal/session">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="day" value="@Model.Day.ToString("yyyy-MM-dd", english)" />
                        <span class="label">Log a session @(Model.Day == Model.Today ? "today" : "on this day")</span>
                        <label class="sr-only" for="jr-game">Game</label>
                        <select id="jr-game" name="game" required>
                            @foreach (var e in Model.Games.Take(60))
                            {
                                <option value="@e.Game.Id">@e.Game.Name</option>
                            }
                        </select>
                        <div class="jr-add-row">
                            <label class="inline-field"><input type="number" name="hours" min="0" max="24" step="1" placeholder="0" inputmode="numeric" aria-label="Hours" /><span>h</span></label>
                            <label class="inline-field"><input type="number" name="minutes" min="0" max="59" step="5" placeholder="30" inputmode="numeric" aria-label="Minutes" /><span>min</span></label>
                        </div>
                        <input type="text" name="note" maxlength="500" placeholder="A note: what happened? (optional)" />
                        <button type="submit" class="btn small">@Icons.Get("plus")Add to the journal</button>
                    </form>
                }
            </section>

            @if (j.Games.Count > 0)
            {
                <section class="side-card rise d2" aria-labelledby="games-h">
                    <h2 id="games-h" class="side-head">@first.ToString("MMMM", english) by game</h2>
                    <ul class="jr-games">
                        @foreach (var g in j.Games.Take(8))
                        {
                            <li>
                                <a href="/games/@g.Game.Id">@g.Game.Name</a>
                                <span class="jr-bar"><i style="width:@(Math.Max(3, g.Minutes * 100 / top))%;background:@colourOf[g.Game.Id]"></i></span>
                                <b class="num">@Fmt.Minutes(g.Minutes)</b>
                            </li>
                        }
                    </ul>
                </section>
            }
            @if (!isThisMonth)
            {
                <a class="more-link" href="/journal">Back to this month @Icons.Get("right")</a>
            }
        </aside>
    </div>
</div>
