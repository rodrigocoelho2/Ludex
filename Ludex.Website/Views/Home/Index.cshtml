@model HomePageModel
@* Home, calm: the game you're on across the whole width with one button, a line of numbers, then two shelves
   (recent games, what to play next from the backlog), wishlist deals when there are any, and friends. *@
@{
    Layout = "_App";
    ViewData["Title"] = "Home";
    ViewData["Wide"] = true;
    var home = Model.Home;
    var hero = home.Hero;
    var stats = home.Stats;
    var entries = Model.Library.Entries;
    var recent = Model.RecentGames;
    var next = Model.PlayNext;
    var deals = Model.Deals;
}

<div class="home4">
    @if (entries.Count == 0)
    {
        <div class="home-body">
            <section class="welcome rise">
                <div class="welcome-tiles" aria-hidden="true">
                    <span style="--tint:#4A3A1E"></span><span style="--tint:#24405C"></span><span style="--tint:#5A1E2E"></span><span style="--tint:#2F4A22"></span>
                </div>
                <div class="welcome-copy">
                    <span class="eyebrow">Hi @Model.UserName</span>
                    <h1>Start your library</h1>
                    <p>Search for a game you're playing, one you finished, or one you want. Add it in one tap and rate it when you're done. Or bring in your whole Steam library with its hours.</p>
                    <div class="actions">
                        <a class="btn" href="/discover">@Icons.Get("search")Find a game</a>
                        <a class="btn ghost" href="/steam">Import from Steam</a>
                        <a class="btn ghost" href="/friends">@Icons.Get("user-plus")Add friends</a>
                    </div>
                </div>
            </section>
        </div>
    }
    else
    {
        @if (hero is not null)
        {
            var heroGame = hero.Game;
            var heroAchievements = Fmt.AchievementPercent(hero.AchievementsUnlocked, hero.AchievementsTotal);
            var heroPlatform = hero.Platform ?? heroGame.Platforms.FirstOrDefault();
            var heroMeta = new[] { heroGame.Developer, heroGame.Year?.ToString(), heroPlatform }.Where(static s => !string.IsNullOrEmpty(s));
            var heroHours = hero.Hours ?? 0;
            var heroHoursText = heroHours > 0 ? Fmt.Hours(heroHours) : "No hours yet";
            var heroPlayed = heroHours > 0 ? " played" : string.Empty;
            <section class="hh" style="--tint:@heroGame.Tint" aria-label="@(hero.Status == GameStatus.Playing ? "Continue playing" : "Last in your library")">
                <div class="hh-art" aria-hidden="true">
                    @if (home.HeroImageId is { } art)
                    {
                        <img class="art-lq" src="@Igdb.Url(art, Igdb.ScreenshotMed)" alt="" decoding="async" />
                        <img class="art-img drift" src="@Igdb.Url(art, Igdb.Full)" alt="" decoding="async" fetchpriority="high" />
                    }
                    else if (heroGame.CoverImageId is { } cover)
                    {
                        <img class="art-img art-from-cover" src="@Igdb.Url(cover, Igdb.CoverBig)" alt="" decoding="async" />
                    }
                </div>
                @if (home.HeroImageId is not null)
                {
                    <span class="credit">Game art · IGDB</span>
                }
                <div class="hh-in">
                    <a class="hh-cover" href="/games/@heroGame.Id" tabindex="-1" aria-hidden="true">
                        <partial name="_Cover" model="new CoverView(heroGame, Model.Transition(heroGame.Id))" />
                    </a>
                    <div class="hh-text">
                        <span class="hh-kicker">@(hero.Status == GameStatus.Playing ? "Continue playing" : "Last in your library")</span>
                        <h1>@heroGame.Name</h1>
                        <p class="hh-meta">@string.Join(" · ", heroMeta)</p>
                        <div class="hh-acts">
                            <a class="btn big" href="/games/@heroGame.Id">@Icons.Get("play")Continue</a>
                            <span class="hh-progress">
                                <span>
                                    <b>@heroHoursText</b>@heroPlayed
                                    @if (heroAchievements is not null)
                                    {
                                        <text> · <b>@hero.AchievementsUnlocked of @hero.AchievementsTotal</b> achievements</text>
                                    }
                                    else if (hero.Rating is { } rated)
                                    {
                                        <text> · rated <b>@rated/10</b></text>
                                    }
                                </span>
                                @if (heroAchievements is { } percent)
                                {
                                    <span class="lib-ach"><i style="width:@percent%"></i></span>
                                }
                            </span>
                        </div>
                    </div>
                </div>
            </section>
        }

        <div class="home-body">
            <p class="home-line rise">
                <b>@Fmt.Count(stats.GameCount)</b> games ·
                <b>@stats.FinishedThisYear</b> finished in @stats.Year ·
                <b>@Model.BacklogCount</b> waiting in your backlog ·
                <b>@Fmt.Count(stats.TotalHours)</b> hours played
            </p>

            @if (recent.Count > 0)
            {
                <section class="shelf rise d1" data-shelf>
                    <partial name="_ShelfHead" model='new ShelfHead("Recent games", null, "/library")' />
                    <div class="shelf-row" data-shelf-row>
                        @foreach (var entry in recent)
                        {
                            var sub = entry.RecentHours is { } rh ? $"{Fmt.Hours(rh)} in the last 2 weeks" : string.Join(" · ", new[] { entry.Platform, entry.Store }.Where(static s => !string.IsNullOrEmpty(s)));
                            <partial name="_ShelfCard" model="new ShelfCard(entry, Model.Transition(entry.Game.Id), sub)" />
                        }
                    </div>
                </section>
            }

            @if (next.Count > 0)
            {
                <section class="shelf rise d1" data-shelf>
                    <partial name="_ShelfHead" model='new ShelfHead("Play next", "From your backlog, best reviewed first", "/library?status=backlog")' />
                    <div class="shelf-row" data-shelf-row>
                        @foreach (var entry in next)
                        {
                            var ttb = entry.Game.TimeToBeatMain;
                            var sub = ttb is { } t ? $"{Fmt.Hours(t)} main story" : string.Empty;
                            var score = entry.Game.CriticScore?.ToString();
                            var scoreCss = (entry.Game.CriticScore ?? 0) >= 70 ? "good" : "mixed";
                            <partial name="_ShelfCard" model="new ShelfCard(entry, Model.Transition(entry.Game.Id), sub, score, scoreCss)" />
                        }
                    </div>
                </section>
            }

            @if (deals.Count > 0)
            {
                <section class="shelf rise d2" data-shelf>
                    <partial name="_ShelfHead" model='new ShelfHead("Wishlist deals", "On sale now, or under your alert", "/library?status=wishlist")' />
                    <div class="shelf-row" data-shelf-row>
                        @foreach (var entry in deals)
                        {
                            var price = entry.Price!;
                            var chip = (price.Cut ?? 0) > 0 ? $"−{price.Cut}%" : "Alert";
                            var sub = Fmt.Money(price.Amount, price.Currency) + (price.Shop is { } shop ? $" · {shop}" : string.Empty);
                            <partial name="_ShelfCard" model='new ShelfCard(entry, Model.Transition(entry.Game.Id), sub, chip, "sale")' />
                        }
                    </div>
                </section>
            }

            @if (home.FriendCount == 0)
            {
                <section class="home-invite rise d2" aria-labelledby="home-friends">
                    <div>
                        <h2 id="home-friends" class="h-calm">Play with friends</h2>
                        <p>Add the people you play with to see what they're playing and which games you share.</p>
                    </div>
                    <a class="btn ghost" href="/friends">Add friends</a>
                </section>
            }
            else
            {
                <section class="split home-split rise d2">
                    <div class="split-main">
                        <div class="section-head">
                            <h2>Friends lately</h2>
                            <a href="/friends">@Fmt.Plural(home.FriendCount, "friend", "friends") @Icons.Get("right")</a>
                        </div>
                        <partial name="_Feed" model="home.Feed" />
                    </div>
                    @if (home.Popular.Count > 0)
                    {
                        <div class="split-side">
                            <div class="section-head">
                                <h2>Your friends love these</h2>
                                <a href="/discover">Discover @Icons.Get("right")</a>
                            </div>
                            <partial name="_Popular" model="home.Popular" />
                        </div>
                    }
                </section>
            }
        </div>
    }
</div>
