@model HomePageModel
@* Home, like Steam's library home: the library down the side, the game you're on across the top, then shelves you
   scroll sideways (recent games, continue playing, what to play next from the backlog, wishlist deals) and what your
   friends are up to. *@
@{
    Layout = "_App";
    ViewData["Title"] = "Home";
    ViewData["Wide"] = true;
    var home = Model.Home;
    var hero = home.Hero;
    var stats = home.Stats;
    var entries = Model.Library.Entries;
    var recent = Model.RecentGames;
    var playing = Model.ContinuePlaying;
    var next = Model.PlayNext;
    var deals = Model.Deals;
    var playingCount = playing.Count + (hero is { Status: GameStatus.Playing } ? 1 : 0);
}

<div class="lib-shell">
    <partial name="_LibrarySidebar" model="new LibrarySidebarView(entries, null, Model.Library.Collections, true)" />

    <section class="lib-main home3">
        @if (entries.Count == 0)
        {
            <section class="welcome rise">
                <div class="welcome-tiles" aria-hidden="true">
                    <span style="--tint:#4A3A1E"></span><span style="--tint:#24405C"></span><span style="--tint:#5A1E2E"></span><span style="--tint:#2F4A22"></span>
                </div>
                <div class="welcome-copy">
                    <span class="eyebrow">Hi @Model.UserName</span>
                    <h1>Start your library</h1>
                    <p>Search for a game you're playing, one you finished, or one you want. Add it in one tap and rate it when you're done. Or bring in your whole Steam library with its hours.</p>
                    <div class="actions">
                        <a class="btn" href="/discover">@Icons.Get("search")Find a game</a>
                        <a class="btn ghost" href="/steam">Import from Steam</a>
                        <a class="btn ghost" href="/friends">@Icons.Get("user-plus")Add friends</a>
                    </div>
                </div>
            </section>
        }
        else
        {
            <section class="home-top">
                @if (hero is not null)
                {
                    var heroGame = hero.Game;
                    var heroAchievements = Fmt.AchievementPercent(hero.AchievementsUnlocked, hero.AchievementsTotal);
                    <article class="hero home-hero rise" style="--tint:@heroGame.Tint">
                        <div class="hero-art" aria-hidden="true">
                            @if (home.HeroImageId is { } art)
                            {
                                <img class="art-lq" src="@Igdb.Url(art, Igdb.ScreenshotMed)" alt="" decoding="async" />
                                <img class="art-img drift" src="@Igdb.Url(art, Igdb.Full)" alt="" decoding="async" fetchpriority="high" />
                            }
                            else if (heroGame.CoverImageId is { } cover)
                            {
                                <img class="art-img art-from-cover drift" src="@Igdb.Url(cover, Igdb.CoverBig)" alt="" decoding="async" />
                            }
                            else
                            {
                                <span class="hero-ghost drift">@heroGame.Name</span>
                            }
                            @if (home.HeroImageId is not null || heroGame.CoverImageId is not null)
                            {
                                <span class="credit">Game art · IGDB</span>
                            }
                        </div>
                        <div class="hero-body">
                            <a class="hero-cover" href="/games/@heroGame.Id" tabindex="-1" aria-hidden="true">
                                <partial name="_Cover" model="new CoverView(heroGame, Model.Transition(heroGame.Id))" />
                            </a>
                            <div class="hero-text">
                                <div class="hero-tag">
                                    <partial name="_StatusChip" model="hero.Status" />
                                    <span>@(hero.Status == GameStatus.Playing ? "Pick up where you left off" : "Last in your library")</span>
                                </div>
                                <h1>@heroGame.Name</h1>
                                <p class="meta">
                                    @if (heroGame.Developer is { } dev) { <span>@dev</span> }
                                    @if (heroGame.Year is { } year) { <span>@year</span> }
                                    @if (heroGame.Platforms.Count > 0) { <span>@string.Join(" · ", heroGame.Platforms.Take(4))</span> }
                                </p>
                                <div class="hero-foot">
                                    <div class="hero-facts">
                                        <div class="fact"><span class="label">Hours</span><b class="num">@(hero.Hours is { } h ? Fmt.Hours(h).Replace(" h", string.Empty) : "—")</b></div>
                                        @if (hero.RecentHours is { } rh)
                                        {
                                            <div class="fact"><span class="label">Last 2 weeks</span><b class="num">@Fmt.Hours(rh).Replace(" h", string.Empty)</b></div>
                                        }
                                        @if (heroAchievements is { } percent)
                                        {
                                            <div class="fact hero-ach">
                                                <span class="label">Achievements</span>
                                                <b class="num">@hero.AchievementsUnlocked<small>/@hero.AchievementsTotal</small></b>
                                                <span class="lib-ach"><i style="width:@percent%"></i></span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="fact"><span class="label">Your rating</span><b class="num gold">@Fmt.Rating(hero.Rating)<small>/10</small></b></div>
                                        }
                                    </div>
                                    <div class="actions">
                                        <a class="btn" href="/games/@heroGame.Id">@Icons.Get("arrow")Continue</a>
                                        @if (hero.Status == GameStatus.Playing)
                                        {
                                            <button class="btn ghost" type="button" data-status="Finished" data-game="@heroGame.Id">@Icons.Get("check")Finished it</button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </article>
                }
                <div class="home-tiles stagger" aria-label="Your numbers">
                    <a class="tile accent" href="/library"><b class="num" data-count="@stats.GameCount">@stats.GameCount</b><span>Games in your library</span></a>
                    <a class="tile" href="/library?status=finished"><b class="num" data-count="@stats.FinishedThisYear">@stats.FinishedThisYear</b><span>Finished in @stats.Year</span></a>
                    <a class="tile" href="/library?status=backlog"><b class="num" data-count="@Model.BacklogCount">@Model.BacklogCount</b><span>In the backlog</span></a>
                    <div class="tile"><b class="num" data-count="@Math.Round(stats.TotalHours)">@Fmt.Count(stats.TotalHours)</b><span>Hours played</span></div>
                </div>
            </section>

            @if (recent.Count > 0)
            {
                <section class="shelf rise" data-shelf>
                    <partial name="_ShelfHead" model='new ShelfHead("Recent games", null, "/library")' />
                    <div class="shelf-row" data-shelf-row>
                        @foreach (var entry in recent)
                        {
                            var sub = entry.RecentHours is { } rh ? $"{Fmt.Hours(rh)} in the last 2 weeks" : Fmt.Ago(entry.UpdatedAt);
                            <partial name="_ShelfCard" model="new ShelfCard(entry, Model.Transition(entry.Game.Id), sub)" />
                        }
                    </div>
                </section>
            }

            @if (playing.Count > 0)
            {
                <section class="shelf rise d1" data-shelf>
                    <partial name="_ShelfHead" model='new ShelfHead("Continue playing", Fmt.Plural(playingCount, "game", "games"), "/library?status=playing")' />
                    <div class="shelf-row" data-shelf-row>
                        @foreach (var entry in playing)
                        {
                            var sub = entry.Hours is { } h && h > 0 ? $"{Fmt.Hours(h)} played" : "Just started";
                            <partial name="_ShelfCard" model="new ShelfCard(entry, Model.Transition(entry.Game.Id), sub)" />
                        }
                    </div>
                </section>
            }

            @if (next.Count > 0)
            {
                <section class="shelf rise d1" data-shelf>
                    <partial name="_ShelfHead" model='new ShelfHead("Play next", "Your backlog, best reviewed first", "/library?status=backlog")' />
                    <div class="shelf-row" data-shelf-row>
                        @foreach (var entry in next)
                        {
                            var ttb = entry.Game.TimeToBeatMain;
                            var sub = ttb is { } t ? $"{Fmt.Hours(t)} main story" : "Length unknown";
                            var chip = entry.Game.CriticScore is { } score ? $"Critics {score}" : null;
                            <partial name="_ShelfCard" model='new ShelfCard(entry, Model.Transition(entry.Game.Id), sub, chip, "critic")' />
                        }
                    </div>
                </section>
            }

            @if (deals.Count > 0)
            {
                <section class="shelf rise d2" data-shelf>
                    <partial name="_ShelfHead" model='new ShelfHead("Wishlist deals", "On sale now, or under your alert", "/library?status=wishlist")' />
                    <div class="shelf-row" data-shelf-row>
                        @foreach (var entry in deals)
                        {
                            var price = entry.Price!;
                            var chip = price.Cut is > 0 ? $"−{price.Cut}%" : "Under your alert";
                            var sub = Fmt.Money(price.Amount, price.Currency) + (price.Shop is { } shop ? $" · {shop}" : string.Empty);
                            <partial name="_ShelfCard" model='new ShelfCard(entry, Model.Transition(entry.Game.Id), sub, chip, "sale")' />
                        }
                    </div>
                </section>
            }
        }

        <section class="split home-split">
            <div class="split-main">
                @if (home.Popular.Count > 0)
                {
                    <div class="section-head">
                        <h2>Your friends love these</h2>
                        <a href="/discover">Discover @Icons.Get("right")</a>
                    </div>
                    <partial name="_Popular" model="home.Popular" />
                }
                else
                {
                    <div class="section-head">
                        <h2>Find something new</h2>
                        <a href="/discover">Discover @Icons.Get("right")</a>
                    </div>
                    <p class="muted small-empty">Games your friends rate well show up here once you have friends on Ludex.</p>
                }
            </div>

            <aside class="split-side" id="friends">
                <div class="section-head">
                    <h2>Friends</h2>
                    <a href="/friends">@(home.FriendCount == 0 ? "Add friends" : Fmt.Plural(home.FriendCount, "friend", "friends")) @Icons.Get("right")</a>
                </div>
                <partial name="_Feed" model="home.Feed" />
            </aside>
        </section>
    </section>
</div>
