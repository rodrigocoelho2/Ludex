@model ListsPageModel
@{
    Layout = "_App";
    ViewData["Title"] = Model.Owner is { } owner ? $"{owner}'s lists" : "Lists";
    var lists = Model.Lists;
}

<div class="page-head rise">
    <div>
        <h1>@(Model.Owner is { } o ? $"{o}'s lists" : "Lists")</h1>
        <p class="muted">Ranked or not, public or just for you: games to play, games to argue about.</p>
    </div>
    <a class="btn" href="/lists/new">@Icons.Get("plus")New list</a>
</div>

<div class="split lists-split">
    <div class="split-main">
        <section class="rise d1" aria-labelledby="mine-h">
            <div class="section-head"><h2 id="mine-h">@(Model.Owner is { } who ? $"By {who}" : "Your lists")</h2></div>
            @if (lists.Mine.Count == 0)
            {
                <div class="empty">
                    <span class="empty-ico">@Icons.Get("list")</span>
                    <p>@(Model.Owner is null ? "No lists yet. Make one here, or from any game's page (Your lists → New list)." : "No lists you can see.")</p>
                </div>
            }
            else
            {
                <div class="lc-grid">
                    @foreach (var list in lists.Mine)
                    {
                        <partial name="_ListCard" model="list" />
                    }
                </div>
            }
        </section>
    </div>
    <aside class="split-side">
        <section class="rise d1" aria-labelledby="pop-h">
            <div class="section-head"><h2 id="pop-h">Popular this week</h2></div>
            <div class="lc-col">
                @foreach (var list in lists.Popular)
                {
                    <partial name="_ListCard" model="list" />
                }
                @if (lists.Popular.Count == 0) { <p class="muted small-empty">Nothing yet.</p> }
            </div>
        </section>
        <section class="rise d2" aria-labelledby="new-h">
            <div class="section-head"><h2 id="new-h">Just changed</h2></div>
            <div class="lc-col">
                @foreach (var list in lists.Recent.Where(l => lists.Popular.All(p => p.Id != l.Id)).Take(6))
                {
                    <partial name="_ListCard" model="list" />
                }
            </div>
        </section>
    </aside>
</div>
