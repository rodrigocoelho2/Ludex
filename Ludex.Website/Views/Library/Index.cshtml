@model LibraryPageModel
@{
    Layout = "_App";
    ViewData["Title"] = "Library";
    ViewData["Wide"] = true;
    var counts = Model.Library.Counts;
    var entries = Model.Library.Entries;
    var copiesOf = entries.GroupBy(static e => e.Game.Id).ToDictionary(static g => g.Key, static g => g.Count());
    var statuses = new (GameStatus? Status, string Label, int Count)[]
    {
        (null, "All games", counts.All),
        (GameStatus.Playing, "Playing", counts.Playing),
        (GameStatus.Backlog, "Backlog", counts.Backlog),
        (GameStatus.Finished, "Finished", counts.Finished),
        (GameStatus.Played, "Played", counts.Played),
        (GameStatus.Wishlist, "Wishlist", counts.Wishlist),
        (GameStatus.Dropped, "Dropped", counts.Dropped),
    };
    var sorts = new (string Key, string Label)[]
    {
        ("played", "Last played"),
        ("name", "Alphabetical"),
        ("friends", "Friends who have it"),
        ("achievements", "% of achievements"),
        ("rating", "Your rating"),
        ("critic", "Critic score"),
        ("hours", "Hours played"),
        ("recent", "Hours in the last 2 weeks"),
        ("shortest", "Shortest to beat"),
        ("release", "Release date"),
        ("added", "Date added to library"),
    };
    var collections = Model.Library.Collections;
    var byGame = collections.SelectMany(static c => c.GameIds.Select(g => (Game: g, c.Id))).ToLookup(static x => x.Game, static x => x.Id);
}

<div class="lib-shell">
    <partial name="_LibrarySidebar" model="new LibrarySidebarView(entries, null, collections)" />

    <section class="lib-main">
        @if (entries.Count == 0)
        {
            <div class="empty rise">
                <span class="empty-ico">@Icons.Get("library")</span>
                <h1>Your library is empty</h1>
                <p>Find a game and add it, or bring in your whole Steam library with its hours.</p>
                <div class="actions">
                    <a class="btn" href="/discover">@Icons.Get("search")Find a game</a>
                    <a class="btn ghost" href="/steam">Import from Steam</a>
                </div>
            </div>
        }
        else
        {
            @* Status as tabs, sort, filters and view in one quiet row; the rest of the filters open under it. The
               hidden status select stays the one source of truth app.js filters by. *@
            <div class="lib-top rise" data-lib-bar>
                <select data-status-filter hidden aria-hidden="true" tabindex="-1">
                    @foreach (var (status, label, count) in statuses)
                    {
                        <option value="@(status?.ToString() ?? string.Empty)" selected="@(Model.Status == status ? "selected" : null)">@label</option>
                    }
                </select>
                <div class="lib-tabs" role="tablist" aria-label="Status">
                    @foreach (var (status, label, count) in statuses)
                    {
                        var on = Model.Status == status;
                        if (status is not null && count == 0 && !on)
                        {
                            continue;
                        }

                        <button type="button" role="tab" class="lib-tab" data-status-tab="@(status?.ToString() ?? string.Empty)" aria-selected="@(on ? "true" : "false")">@(status is null ? "All" : label) <b>@count</b></button>
                    }
                </div>
                <div class="lib-tools">
                    <span class="in compact lib-find">@Icons.Get("search")<input type="search" placeholder="Filter" aria-label="Filter the library" autocomplete="off" data-text-filter /></span>
                    <label class="lib-sort">
                        <span>Sort</span>
                        <select data-sort>
                            @foreach (var (key, label) in sorts)
                            {
                                <option value="@key">@label</option>
                            }
                        </select>
                    </label>
                    <button type="button" class="btn soft small lib-filters-btn" data-filters-toggle aria-expanded="false" aria-controls="lib-filters">@Icons.Get("filter")Filters<b class="lib-filters-n" data-filters-count hidden></b></button>
                    <span class="seg lib-view" role="group" aria-label="View">
                        <button type="button" class="seg-btn" data-view="grid" aria-pressed="true" aria-label="Covers" title="Covers">@Icons.Get("grid")</button>
                        <button type="button" class="seg-btn" data-view="list" aria-pressed="false" aria-label="List" title="List">@Icons.Get("list")</button>
                    </span>
                </div>
            </div>
            <div class="lib-filters" id="lib-filters" data-filters hidden>
                <label class="lib-filter">
                    <span>Platform</span>
                    <select data-platform-filter>
                        <option value="">All platforms</option>
                        @foreach (var (family, platforms) in Model.Families)
                        {
                            <option value="family:@family">@family</option>
                            foreach (var platform in platforms.Where(p => !string.Equals(p, family, StringComparison.OrdinalIgnoreCase)))
                            {
                                <option value="platform:@platform">&nbsp;&nbsp;@platform</option>
                            }
                        }
                    </select>
                </label>
                @if (Model.Copies.Any())
                {
                    <label class="lib-filter">
                        <span>Store or format</span>
                        <select data-copy-filter>
                            <option value="">Any</option>
                            @foreach (var copy in Model.Copies)
                            {
                                <option value="@copy">@copy</option>
                            }
                        </select>
                    </label>
                }
                @if (collections.Count > 0)
                {
                    <label class="lib-filter">
                        <span>Collection</span>
                        <select data-collection-filter>
                            <option value="">Any</option>
                            @foreach (var c in collections)
                            {
                                <option value="@c.Id" selected="@(Model.Collection == c.Id ? "selected" : null)">@c.Name (@c.GameIds.Count)</option>
                            }
                        </select>
                    </label>
                    <span class="lib-col-acts" data-col-acts hidden>
                        <button type="button" class="link-btn" data-col-rename>Rename</button>
                        <button type="button" class="link-btn danger" data-col-delete>Delete</button>
                    </span>
                }
                <label class="check lib-friends"><input type="checkbox" data-friends-filter /><span>Friends have it</span></label>
                <label class="lib-size" data-size-box>
                    <span>Cover size</span>
                    <input type="range" min="112" max="296" step="8" value="176" data-card-size />
                </label>
            </div>
            <div class="lib-sub">
                <p class="lib-count muted" data-shown-label>@Fmt.Plural(entries.Count, "game", "games")</p>
                <span class="lib-bar-push"></span>
                <button type="button" class="link-btn" data-next-open>@Icons.Get("sparkle")What should I play?</button>
                <button type="button" class="link-btn lib-select-btn" data-select-mode aria-pressed="false">@Icons.Get("check")Select</button>
            </div>

            <div class="lib-head" data-lib-head hidden>
                <span></span>
                <button type="button" data-sort-col="name">Name</button>
                <span>Status</span>
                <button type="button" data-sort-col="hours">Hours</button>
                <button type="button" data-sort-col="achievements">Achievements</button>
                <button type="button" data-sort-col="rating">Rating</button>
                <button type="button" data-sort-col="critic">Critics</button>
                <button type="button" data-sort-col="shortest">To beat</button>
                <button type="button" data-sort-col="played">Last played</button>
            </div>
            <div class="lib-grid" data-library>
                @foreach (var entry in entries)
                {
                    var game = entry.Game;
                    var copy = Ludex.Library.Platforms.GameCopies.Label(entry.Store, entry.Format);
                    var achievementPercent = Fmt.AchievementPercent(entry.AchievementsUnlocked, entry.AchievementsTotal);
                    var inCollections = string.Join(",", byGame[game.Id]);
                    var achievementText = entry.AchievementsTotal is > 0 ? $"{entry.AchievementsUnlocked ?? 0}/{entry.AchievementsTotal}" : string.Empty;
                    var several = copiesOf[game.Id] > 1;
                    var platformTag = several ? $" · {entry.Platform ?? "copy"}" : string.Empty;
                    <a class="lib-card" href="/games/@game.Id?entry=@entry.EntryId" aria-label="@game.Name@platformTag" draggable="true" data-drag-game="@game.Id" data-entry="@entry.EntryId"
                       data-collections=",@inCollections," data-achievements="@(achievementPercent ?? -1)" data-critic="@(game.CriticScore ?? 0)"
                       data-ttb="@Fmt.Input(game.TimeToBeatMain ?? 0)" data-recent="@Fmt.Input(entry.RecentHours ?? 0)" data-cover="@(game.CoverImageId is { } dc ? Igdb.Url(dc, Igdb.CoverBig) : string.Empty)" data-tint="@game.Tint"
                       data-name="@game.Name.ToLowerInvariant()" data-status="@entry.Status" data-family="@entry.PlatformFamily"
                       data-platform="@(entry.Platform ?? string.Empty)" data-format="@(entry.Format?.ToString() ?? string.Empty)" data-store="@(entry.Store ?? string.Empty)"
                       data-friends="@game.FriendNames.Count" data-rating="@(entry.Rating ?? 0)" data-hours="@Fmt.Input(entry.Hours ?? 0)"
                       data-release="@(game.Year ?? 0)" data-added="@entry.AddedAt.ToUnixTimeSeconds()" data-updated="@entry.UpdatedAt.ToUnixTimeSeconds()"
                       data-game="@game.Id" data-title="@game.Name" data-ach-text="@achievementText" data-friend-names="@(string.Join(", ", game.FriendNames))"
                       data-dev="@(game.Developer ?? string.Empty)" data-copy="@(copy ?? string.Empty)">
                        <span class="lib-cover">
                            <partial name="_Cover" model="new CoverView(game, Model.Transition(game.Id))" />
                            @if (entry.Rating is { } rating)
                            {
                                <span class="lib-score">@rating</span>
                            }
                            @if (game.CriticScore is { } critic)
                            {
                                <span class="lib-critic @(critic >= 70 ? "good" : "mixed")" title="Critic score">@critic</span>
                            }
                            @if (entry.Status == GameStatus.Wishlist && entry.Price?.Amount is { } price)
                            {
                                <span class="lib-price@(entry.Price.Cut is > 0 ? " sale" : string.Empty)">@(entry.Price.Cut is > 0 ? $"−{entry.Price.Cut}% " : string.Empty)@Fmt.Money(price, entry.Price.Currency)</span>
                            }
                        </span>
                        @if (achievementPercent is { } ap)
                        {
                            <span class="lib-ach" title="@entry.AchievementsUnlocked of @entry.AchievementsTotal achievements"><i style="width:@ap%"></i></span>
                        }
                        <span class="lib-meta">
                            <span class="lib-name">@game.Name</span>
                            <span class="lib-line"><i class="dot-@Fmt.StatusCss(entry.Status)" aria-hidden="true"></i>@Fmt.Status(entry.Status)@(entry.Hours is { } h && h > 0 ? " · " + Fmt.Hours(h) : string.Empty)@platformTag</span>
                        </span>
                        <span class="lib-row" aria-hidden="true">
                            <span class="c-name"><b>@game.Name</b><small>@(string.Join(" · ", new[] { entry.Platform, copy }.Where(static s => s is not null).Distinct()))</small></span>
                            <span class="c-status"><i class="dot-@Fmt.StatusCss(entry.Status)"></i>@Fmt.Status(entry.Status)</span>
                            <span class="c-num">@(entry.Hours is { } lh && lh > 0 ? Fmt.Hours(lh) : "—")</span>
                            <span class="c-ach">
                                @if (achievementPercent is { } lp)
                                {
                                    <span>@achievementText</span><span class="lib-ach"><i style="width:@lp%"></i></span>
                                }
                                else
                                {
                                    <span class="faint">—</span>
                                }
                            </span>
                            <span class="c-num gold">@Fmt.Rating(entry.Rating)</span>
                            <span class="c-num">@(game.CriticScore?.ToString() ?? "—")</span>
                            <span class="c-num">@(game.TimeToBeatMain is { } lt ? Fmt.Hours(lt) : "—")</span>
                            <span class="c-when">@Fmt.Ago(entry.UpdatedAt)</span>
                        </span>
                    </a>
                }
            </div>
            <p class="muted small-empty" data-none hidden>No game matches these filters.</p>

            <div class="sel-bar" data-sel-bar hidden role="region" aria-label="Selected games">
                <b class="sel-count" data-sel-count>0 selected</b>
                <label class="sel-field">
                    <span class="sr-only">Set status</span>
                    <select data-sel-status>
                        <option value="">Set status…</option>
                        @foreach (var (status, label, _) in statuses.Where(static s => s.Status is not null))
                        {
                            <option value="@status">@label</option>
                        }
                    </select>
                </label>
                <label class="sel-field">
                    <span class="sr-only">Add to a collection</span>
                    <select data-sel-collection>
                        <option value="">Add to collection…</option>
                        @foreach (var c in collections)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                        <option value="new">New collection…</option>
                    </select>
                </label>
                <button type="button" class="btn ghost small" data-sel-takeout hidden>Take out of this collection</button>
                <button type="button" class="btn ghost small danger" data-sel-remove>@Icons.Get("x")Remove</button>
                <span class="lib-bar-push"></span>
                <button type="button" class="link-btn" data-sel-all>Select all shown</button>
                <button type="button" class="icon-btn" data-sel-clear aria-label="Clear the selection" title="Clear (Esc)">@Icons.Get("x")</button>
            </div>
            <div class="lib-pop" data-lib-pop hidden aria-hidden="true"></div>
        }
    </section>
</div>

<dialog class="next-dialog" data-next aria-labelledby="next-title">
    <form method="dialog" class="next-in">
        <div class="next-head">
            <h2 id="next-title">What should I play next?</h2>
            <button class="icon-btn" value="close" aria-label="Close">@Icons.Get("x")</button>
        </div>
        <div class="next-opts">
            <div class="next-opt">
                <span class="label">Time you have</span>
                <div class="yg-status" role="group" aria-label="Time you have">
                    <button type="button" class="pill-btn" data-next-hours="5" aria-pressed="false">5 h</button>
                    <button type="button" class="pill-btn" data-next-hours="10" aria-pressed="true">10 h</button>
                    <button type="button" class="pill-btn" data-next-hours="25" aria-pressed="false">25 h</button>
                    <button type="button" class="pill-btn" data-next-hours="60" aria-pressed="false">60 h</button>
                    <button type="button" class="pill-btn" data-next-hours="0" aria-pressed="false">Any</button>
                </div>
            </div>
            <div class="next-opt">
                <span class="label">From</span>
                <div class="yg-status" role="group" aria-label="From">
                    <button type="button" class="pill-btn" data-next-from="Backlog" aria-pressed="true">Backlog</button>
                    <button type="button" class="pill-btn" data-next-from="Wishlist" aria-pressed="false">Wishlist</button>
                    <button type="button" class="pill-btn" data-next-from="both" aria-pressed="false">Both</button>
                </div>
            </div>
        </div>
        <div class="next-picks" data-next-picks></div>
        <div class="next-foot">
            <span class="muted" data-next-note></span>
            <button type="button" class="btn small" data-next-shuffle>@Icons.Get("sparkle")Shuffle</button>
        </div>
    </form>
</dialog>

