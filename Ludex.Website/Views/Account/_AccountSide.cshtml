@model AccountPageModel
@{
    var active = (string)ViewData["Tab"]!;
    var first = Model.IsFirstAccount && active == "create";

    // The wall: columns of covers drifting up and down behind the pitch. The covers are the games people here have,
    // filled up with well-known ones from IGDB (a new order every visit); without IGDB, coloured tiles with names.
    var builtIn = new (string Name, string Tint)[]
    {
        ("Elden Ring", "#4A3A1E"), ("Hades II", "#5A1E2E"), ("Baldur's Gate 3", "#2E2445"), ("Silksong", "#1F3B3A"), ("Pokémon Z-A", "#24405C"),
        ("Cyberpunk 2077", "#5C4A10"), ("Red Dead 2", "#5A2A18"), ("The Witcher 3", "#22332A"), ("Celeste", "#3D2357"), ("Stardew Valley", "#2F4A22"),
        ("Balatro", "#3A1F4A"), ("Expedition 33", "#2B3550"), ("Dune Imperium", "#5A3A14"), ("Hollow Knight", "#1E2B3E"), ("Persona 5", "#5C1A1A"),
        ("Outer Wilds", "#1F3550"), ("Disco Elysium", "#3B2E28"), ("Portal 2", "#2A3540"), ("Sekiro", "#4A2020"), ("Hi-Fi Rush", "#3A2A55"),
        ("Astro Bot", "#24405C"), ("Split Fiction", "#2B3550"), ("Minecraft", "#2F4A22"), ("Mario Kart World", "#5A1E2E"), ("Catan", "#5C4A10"),
    };
    var withCovers = Model.Wall.Where(static g => g.CoverImageId is not null).Select(static g => (g.Name, g.Tint, g.CoverImageId)).ToList();
    var tiles = withCovers.Count >= 12
        ? withCovers
        : withCovers.Concat(builtIn.Where(b => !withCovers.Any(c => c.Name.Contains(b.Name, StringComparison.OrdinalIgnoreCase)))
                                   .Select(static b => (b.Name, b.Tint, (string?)null))).ToList();

    const int columns = 9;
    const int perColumn = 7;
    string[] speeds = ["78s", "64s", "92s", "70s", "86s", "60s", "82s", "74s", "96s"];
    var lanes = Enumerable.Range(0, columns)
        .Select(c => Enumerable.Range(0, perColumn).Select(r => tiles[(c + (r * columns)) % tiles.Count]).ToList())
        .ToList();
}
<aside class="au-side">
    <div class="wall" aria-hidden="true">
        @for (var c = 0; c < lanes.Count; c++)
        {
            <div class="wall-col@(c % 2 == 1 ? " down" : string.Empty)" style="--speed:@speeds[c % speeds.Length]">
                @* Every lane twice in a row: sliding by half its height loops without a seam. *@
                @for (var copy = 0; copy < 2; copy++)
                {
                    foreach (var (name, tint, image) in lanes[c])
                    {
                        <div class="wall-tile" style="--tint:@tint">
                            @if (image is not null)
                            {
                                <img class="cover-img" src="@Igdb.Url(image, Igdb.CoverBig)" alt="" decoding="async" />
                            }
                            else
                            {
                                <span>@name</span>
                            }
                        </div>
                    }
                }
            </div>
        }
    </div>
    <div class="au-veil"></div>
    <div class="au-copy">
        <a class="brand big" href="/sign-in">@Icons.Logo(40)<span>LUDEX</span></a>
        <div class="au-pitch">
            @if (first)
            {
                <h2 class="rise">Set up your Ludex.</h2>
                <p class="rise d1">Create the first account. It becomes the admin; everyone else in the house can make their own.</p>
            }
            else
            {
                <h2 class="rise">Every game you've played. In one place.</h2>
            }
            <ul class="au-points stagger">
                <li>Your library, with where you are and a rating for each game</li>
                <li>See which of your friends have the same games</li>
                <li>Covers, screenshots and the full sheet of every game</li>
            </ul>
        </div>
        <p class="au-foot">Self-hosted · .NET 10 · SQL Server · Docker</p>
    </div>
</aside>
