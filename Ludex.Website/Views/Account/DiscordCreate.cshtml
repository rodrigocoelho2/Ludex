@model AccountPageModel
@* A new account with Discord: Discord already said who this is, so only the user name is left to pick. *@
@{
    ViewData["Title"] = "Create account";
    ViewData["Tab"] = "create";
}

<div class="au">
    <partial name="_AccountSide" model="Model" />

    <main class="au-main">
        <form class="au-form rise d1" method="post" action="/create-account/discord" autocomplete="off">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

            <partial name="_AccountCard" model="Model" />

            <div class="au-head">
                <h1>Almost there</h1>
                <p class="muted">You're signed in to Discord as <b>@Model.DiscordName</b>. Pick the user name your friends will find you by.</p>
            </div>

            <label class="field">
                <span class="label">User name</span>
                <span class="in">
                    @Icons.Get("user")
                    <input name="userName" type="text" value="@Model.UserName" autocapitalize="none" spellcheck="false" pattern="[A-Za-z0-9._\-]{3,32}" required autofocus />
                </span>
                <small class="hint">3–32 letters, numbers, dots, dashes or underscores.</small>
            </label>

            <button class="btn wide discord-btn" type="submit"><span class="discord-mark" aria-hidden="true"></span>Create account with Discord</button>

            <p class="au-fine">Already have an account here? <a href="/sign-in">Sign in with your password</a>, then link Discord in Settings to keep your library.</p>
        </form>
    </main>
</div>
