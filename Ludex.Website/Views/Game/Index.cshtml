@model GamePageModel
@{
    Layout = "_App";
    var detail = Model.Detail;
    var game = detail.Game;
    var mine = detail.Mine;
    ViewData["Title"] = game.Name;
    ViewData["Wide"] = true;
    var hasSide = Model.Sidebar.Count > 0;
    var copyNow = mine?.Store ?? mine?.Format?.ToString();
    var copyChoices = Ludex.Library.Platforms.GameCopies.Choices(mine?.Platform);
    var copyLabel = Ludex.Library.Platforms.GameCopies.UsesStores(mine?.Platform) ? "Bought on" : "Copy";
    var statuses = new[] { GameStatus.Playing, GameStatus.Backlog, GameStatus.Finished, GameStatus.Played, GameStatus.Wishlist, GameStatus.Dropped };
    var achievements = Model.Achievements;
    var mineCollections = mine?.CollectionIds ?? [];
    var shots = detail.Screenshots;
    var genre = detail.Genres.FirstOrDefault();
    var art = detail.HeroImageId ?? shots.FirstOrDefault();
    var ratedBy = detail.Friends.Count(static f => f.Rating is not null);
    var yourLine = new List<string>();
    if (mine?.Hours is { } myHours) { yourLine.Add($"{Fmt.Hours(myHours)} on record"); }
    if (mine is not null) { yourLine.Add($"added {Fmt.ShortDate(mine.AddedAt)}"); }
    var heroMeta = new List<string>();
    if (game.Developer is { } heroDev) { heroMeta.Add(heroDev); }
    if (game.Year is { } heroYear) { heroMeta.Add(heroYear.ToString(System.Globalization.CultureInfo.InvariantCulture)); }
    heroMeta.AddRange(detail.Genres.Take(2));
}

<div class="lib-shell@(hasSide ? string.Empty : " no-side")">
@if (hasSide)
{
    <partial name="_LibrarySidebar" model="new LibrarySidebarView(Model.Sidebar, game.Id, Model.SidebarCollections)" />
}
<div class="lib-main">
<article class="game3" data-game-page="@game.Id" style="--tint:@game.Tint">
    @* The hero: the game's wide art from edge to edge, the title over it — like Steam's library page. *@
    <header class="g-hero">
        <div class="g-hero-art" aria-hidden="true">
            @if (art is not null)
            {
                <img class="art-lq" src="@Igdb.Url(art, Igdb.ScreenshotMed)" alt="" decoding="async" />
                <img class="art-img drift" src="@Igdb.Url(art, Igdb.Full)" alt="" decoding="async" fetchpriority="high" />
            }
            else if (game.CoverImageId is { } heroCover)
            {
                <img class="art-img art-from-cover" src="@Igdb.Url(heroCover, Igdb.CoverBig)" alt="" decoding="async" />
            }
            else
            {
                <span class="banner-ghost">@game.Name</span>
            }
        </div>
        @if (art is not null)
        {
            <span class="credit">Game art · IGDB</span>
        }
        <div class="g-hero-in rise">
            <nav class="crumbs" aria-label="Breadcrumb">
                <a href="/library">Library</a>
                @if (genre is not null) { <span aria-hidden="true">›</span><a href="/discover?q=@Uri.EscapeDataString(genre)">@genre</a> }
            </nav>
            <h1>@game.Name</h1>
            <div class="g-hero-meta">
                @if (heroMeta.Count > 0) { <span>@string.Join(" · ", heroMeta)</span> }
                <span class="lib-pill@(mine is null ? " out" : string.Empty)" data-lib-pill>
                    @Icons.Get(mine is null ? "plus" : "check")<span data-lib-pill-text>@(mine is null ? "Not in your library" : $"In your library · {Fmt.Status(mine.Status)}")</span>
                </span>
            </div>
        </div>
    </header>

    @* Your game: status, rating and favourite save as you tap (Steam's Play bar). *@
    <form id="game-form" class="your-game rise d1" data-game-form data-game="@game.Id" data-entry="@mine?.EntryId" data-in-library="@(mine is null ? "false" : "true")" autocomplete="off">
        <div class="yg-title">
            <span class="eyebrow">Your game</span>
            <span class="muted" data-your-line>@(yourLine.Count == 0 ? "Not in your library yet: pick a status or a rating" : string.Join(" · ", yourLine))</span>
        </div>
        <div class="yg-status" role="group" aria-label="Status">
            @foreach (var status in statuses)
            {
                <button type="button" class="pill-btn" data-set-status="@status" aria-pressed="@(mine?.Status == status ? "true" : "false")">@Fmt.Status(status)</button>
            }
        </div>
        <div class="yg-rating">
            <span class="muted">Rating</span>
            <div class="rating" role="group" aria-label="Rating from 1 to 10">
                @for (var n = 1; n <= 10; n++)
                {
                    <button type="button" class="rate" data-set-rating="@n" aria-pressed="@(mine?.Rating == n ? "true" : "false")" aria-label="Rate @n out of 10" style="--i:@n">@n</button>
                }
            </div>
            <b class="num gold yg-value"><span data-rating-value>@Fmt.Rating(mine?.Rating)</span><small>/10</small></b>
            <button type="button" class="link-btn" data-clear-rating hidden="@(mine?.Rating is null ? "hidden" : null)">Clear</button>
        </div>
        <div class="yg-acts">
            <button type="button" class="btn soft small fav-btn" data-favorite aria-pressed="@(mine?.IsFavorite == true ? "true" : "false")" hidden="@(mine is null ? "hidden" : null)">
                @Icons.Get("heart")<span data-favorite-label>@(mine?.IsFavorite == true ? "Your favourite" : "Make favourite")</span>
            </button>
        </div>
    </form>

    @* Your copies: a game owned on two platforms is two entries, each with its own status, hours and achievements. *@
    @if (mine is not null)
    {
        var otherPlatforms = Model.PlatformChoices.Where(p => mine.Copies.All(c => !string.Equals(c.Platform, p, StringComparison.OrdinalIgnoreCase))).ToList();
        <section class="copies rise d1" aria-label="Your copies">
            @if (mine.Copies.Count > 1)
            {
                <span class="copies-label">Your copies</span>
                @foreach (var c in mine.Copies)
                {
                    var trophies = c.AchievementsTotal is > 0 ? $" · {c.AchievementsUnlocked ?? 0}/{c.AchievementsTotal}" : string.Empty;
                    <a class="copy-chip@(c.EntryId == mine.EntryId ? " on" : string.Empty)" href="/games/@game.Id?entry=@c.EntryId" aria-current="@(c.EntryId == mine.EntryId ? "page" : null)">
                        <i class="dot-@Fmt.StatusCss(c.Status)" aria-hidden="true"></i>
                        <b>@(c.Platform ?? "No platform")</b>
                        <small>@Fmt.Status(c.Status)@(c.Hours is { } ch && ch > 0 ? $" · {Fmt.Hours(ch)}" : string.Empty)@trophies</small>
                    </a>
                }
            }
            <details class="copy-add">
                <summary>@Icons.Get("plus")<span>@(mine.Copies.Count > 1 ? "Another copy" : "Own it on another platform too?")</span></summary>
                <form method="post" action="/games/@game.Id/copy">
                    @Html.AntiForgeryToken()
                    <label class="inline-field">
                        <span>Copy on</span>
                        <select name="platform">
                            @foreach (var platform in otherPlatforms)
                            {
                                <option value="@platform">@platform</option>
                            }
                            <option value="Other">Other</option>
                        </select>
                    </label>
                    <button class="btn small soft" type="submit">@Icons.Get("plus")Add copy</button>
                    <small class="muted">Its own status, hours and achievements or trophies; the library shows it as a game of its own.</small>
                </form>
            </details>
        </section>
    }

    @* Two columns on a usual screen (media and text, details beside); on a wide or ultrawide one the screenshots,
       the text and the details sit side by side, and the screenshots never get taller than the screen allows. *@
    <div class="g-cols@(shots.Count == 0 ? " no-media" : string.Empty)">
            @if (shots.Count > 0)
            {
                <section class="g-block g-media-block rise d2">
                    <div class="viewer" data-viewer>
                        @for (var i = 0; i < shots.Count; i++)
                        {
                            <button type="button" class="viewer-shot@(i == 0 ? " on" : string.Empty)" data-full="@Igdb.Url(shots[i], Igdb.Full)" aria-label="Open screenshot @(i + 1) full size" tabindex="@(i == 0 ? "0" : "-1")">
                                <img class="cover-img" src="@Igdb.Url(shots[i], i == 0 ? Igdb.Full : Igdb.ScreenshotMed)" data-big="@Igdb.Url(shots[i], Igdb.Full)" alt="" decoding="async" loading="@(i == 0 ? "eager" : "lazy")" />
                            </button>
                        }
                        <span class="viewer-tag">Screenshot · IGDB</span>
                        @if (shots.Count > 1)
                        {
                            <button type="button" class="viewer-nav prev" data-viewer-step="-1" aria-label="Previous screenshot">@Icons.Get("left")</button>
                            <button type="button" class="viewer-nav next" data-viewer-step="1" aria-label="Next screenshot">@Icons.Get("right")</button>
                            <span class="viewer-count" data-viewer-count>1 / @shots.Count</span>
                        }
                    </div>
                    @if (shots.Count > 1)
                    {
                        <div class="thumbs" role="group" aria-label="Screenshots" style="--n:@shots.Count">
                            @for (var i = 0; i < shots.Count; i++)
                            {
                                <button type="button" class="thumb@(i == 0 ? " on" : string.Empty)" data-viewer-pick="@i" aria-label="Screenshot @(i + 1)" aria-pressed="@(i == 0 ? "true" : "false")">
                                    <img src="@Igdb.Url(shots[i], Igdb.ScreenshotMed)" alt="" loading="lazy" decoding="async" />
                                </button>
                            }
                        </div>
                    }
                </section>
            }

        <div class="g-text rise d2">
            @if (achievements is { Total: > 0 })
            {
                var percent = Fmt.AchievementPercent(achievements.Unlocked, achievements.Total) ?? 0;
                <section class="g-block achievements" data-achievements>
                    <div class="ach-head">
                        <h2 class="g-h">Achievements</h2>
                        <span class="ach-count"><b class="num">@achievements.Unlocked</b> / @achievements.Total <span class="muted">(@percent%)</span></span>
                    </div>
                    <span class="ach-bar"><i style="width:@percent%"></i></span>
                    @if (achievements.Private)
                    {
                        <p class="muted small-empty">Steam won't show which ones you have: set Game details to Public in Steam's privacy settings.</p>
                    }
                    <ul class="ach-grid">
                        @for (var i = 0; i < achievements.Items.Count; i++)
                        {
                            var a = achievements.Items[i];
                            <li class="ach@(a.Unlocked ? " on" : string.Empty)" hidden="@(i >= 12 ? "hidden" : null)" data-ach-item>
                                <span class="ach-ico">
                                    @if (a.IconUrl is { } icon)
                                    {
                                        <img src="@icon" alt="" loading="lazy" decoding="async" />
                                    }
                                </span>
                                <span class="ach-text">
                                    <b>@(a.Hidden && !a.Unlocked ? "Hidden achievement" : a.Name)</b>
                                    <small>@(a.Description ?? (a.Hidden ? "Unlock it to see what it is." : string.Empty))</small>
                                    <small class="ach-meta">@(a.UnlockedAt is { } at ? "Unlocked " + Fmt.ShortDate(at) : "Locked")@(a.GlobalPercent is { } gp ? $" · {gp.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)}% of players" : string.Empty)</small>
                                </span>
                            </li>
                        }
                    </ul>
                    @if (achievements.Items.Count > 12)
                    {
                        <button type="button" class="link-btn" data-ach-more>Show all @achievements.Items.Count</button>
                    }
                </section>
            }

            <section class="g-block">
                <h2 class="g-h">About this game</h2>
                @if (!string.IsNullOrWhiteSpace(detail.Summary))
                {
                    <p class="summary">@detail.Summary</p>
                }
                else
                {
                    <p class="muted">No summary in the catalog for this one.</p>
                }
                @if (detail.Modes.Count > 0)
                {
                    <p class="muted modes">@string.Join(" · ", detail.Modes)</p>
                }
            </section>

            <section class="g-block">
                <h2 class="g-h">Your notes</h2>
                <label class="sr-only" for="g-notes">Your notes</label>
                <textarea id="g-notes" name="notes" form="game-form" rows="3" maxlength="2000" placeholder="What did you think?">@(mine?.Notes)</textarea>
                <div class="notes-row">
                    <label class="inline-field">
                        <span>Hours</span>
                        <input name="hours" form="game-form" type="number" inputmode="decimal" min="0" max="99999" step="0.5" value="@Fmt.Input(mine?.Hours)" placeholder="—" />
                    </label>
                    <label class="inline-field">
                        <span>Played on</span>
                        <select name="platform" form="game-form">
                            <option value="">—</option>
                            @foreach (var platform in Model.PlatformChoices)
                            {
                                <option value="@platform" selected="@(string.Equals(mine?.Platform, platform, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@platform</option>
                            }
                            <option value="Other" selected="@(mine?.Platform == "Other" ? "selected" : null)">Other</option>
                        </select>
                    </label>
                    <label class="inline-field">
                        <span data-copy-label>@copyLabel</span>
                        <select name="copy" form="game-form" data-copy data-choices="@System.Text.Json.JsonSerializer.Serialize(Model.CopyChoices)">
                            <option value="">—</option>
                            @foreach (var choice in copyChoices)
                            {
                                <option value="@choice" selected="@(string.Equals(copyNow, choice, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@choice</option>
                            }
                        </select>
                    </label>
                    <button class="btn small notes-save" type="submit" form="game-form">@Icons.Get("check")Save</button>
                </div>
            </section>
        </div>

        <aside class="g-side rise d2">
            <section class="side-card g-details">
                <div class="g-details-top">
                    <span class="g-details-cover"><partial name="_Cover" model="new CoverView(game, Model.Transition(game.Id), Large: true)" /></span>
                    <dl class="g-facts">
                        @if (detail.ReleaseDate is { } released)
                        {
                            <dt>Released</dt><dd>@Fmt.LongDate(released)</dd>
                        }
                        @if (game.Developer is { } developer)
                        {
                            <dt>Developer</dt><dd><a href="/discover?q=@Uri.EscapeDataString(developer)">@developer</a></dd>
                        }
                        @if (detail.Publisher is { } publisher && publisher != game.Developer)
                        {
                            <dt>Publisher</dt><dd><a href="/discover?q=@Uri.EscapeDataString(publisher)">@publisher</a></dd>
                        }
                    </dl>
                </div>
                @if (game.CriticScore is not null || game.TimeToBeatMain is not null || game.TimeToBeatFull is not null)
                {
                    <div class="g-numbers">
                        @if (game.CriticScore is { } critic)
                        {
                            <span class="g-num"><b class="critic @(critic >= 75 ? "good" : critic >= 50 ? "mixed" : "bad")">@critic</b><small>Critic score</small></span>
                        }
                        @if (game.TimeToBeatMain is { } main)
                        {
                            <span class="g-num"><b class="num">@Fmt.Hours(main)</b><small>Main story</small></span>
                        }
                        @if (game.TimeToBeatFull is { } full)
                        {
                            <span class="g-num"><b class="num">@Fmt.Hours(full)</b><small>100%</small></span>
                        }
                    </div>
                }
                <div class="g-reception">
                    <span class="side-head">Friends' rating</span>
                    @if (detail.FriendsAverageRating is { } average)
                    {
                        <span><span class="reception @Fmt.ReceptionCss(average)">@Fmt.Reception(average)</span> <span class="muted">· @Fmt.Average(average) from @Fmt.Plural(ratedBy, "friend", "friends")</span></span>
                    }
                    else
                    {
                        <span class="muted">@(detail.Friends.Count == 0 ? "No friends have it yet" : "Not rated by friends yet")</span>
                    }
                </div>
                @if (mine is not null)
                {
                    <div class="g-collections" data-collections data-game="@game.Id">
                        <span class="side-head">Collections</span>
                        <div class="g-col-chips">
                            @foreach (var c in detail.Collections.Where(c => mineCollections.Contains(c.Id)))
                            {
                                <span class="col-chip" data-col-chip="@c.Id">@c.Name<button type="button" aria-label="Take it out of @c.Name" data-col-out="@c.Id">@Icons.Get("x")</button></span>
                            }
                            <select class="col-add" data-col-add aria-label="Add to a collection">
                                <option value="">+ Add to…</option>
                                @foreach (var c in detail.Collections.Where(c => !mineCollections.Contains(c.Id)))
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                                <option value="new">New collection…</option>
                            </select>
                        </div>
                    </div>
                }
                @if (detail.Genres.Count > 0 || game.Platforms.Count > 0)
                {
                    <div class="g-tags">
                        @foreach (var g in detail.Genres) { <span class="tag accent">@g</span> }
                        @foreach (var platform in game.Platforms) { <span class="tag">@platform</span> }
                    </div>
                }
            </section>

            <section class="side-card">
                <h2 class="side-head">Friends who have it</h2>
                @if (detail.Friends.Count == 0)
                {
                    <p class="muted small-empty">None of your friends have it yet.</p>
                }
                else
                {
                    <ul class="friend-mini">
                        @foreach (var friend in detail.Friends)
                        {
                            var playing = friend.Status == GameStatus.Playing;
                            <li>
                                <a class="row-soft" href="/u/@friend.UserName">
                                    @Avatars.Get(friend.Id, friend.UserName, friend.AvatarVersion, playing ? "state-playing" : null)
                                    <span class="friend-mini-text">
                                        <b>@friend.UserName</b>
                                        <small class="@(playing ? "playing" : null)">@(playing ? "Playing now" : Fmt.Status(friend.Status))@(friend.Hours is { } fh ? $" · {Fmt.Hours(fh)}" : string.Empty)</small>
                                    </span>
                                    <b class="num @(friend.Rating is null ? "muted" : "gold") mini-rating">@Fmt.Rating(friend.Rating)</b>
                                </a>
                            </li>
                        }
                    </ul>
                    @if (detail.FriendsAverageRating is { } avg)
                    {
                        <div class="side-total"><span>Friends' average</span><b class="num gold">@Fmt.Average(avg)</b></div>
                    }
                }
            </section>

            @if (mine?.Status == GameStatus.Wishlist)
            {
                var price = detail.Price;
                <section class="side-card price-card" data-price data-game="@game.Id">
                    <h2 class="side-head">Best PC price</h2>
                    @if (price?.Amount is { } amount)
                    {
                        <div class="price-now">
                            <b class="num">@Fmt.Money(amount, price.Currency)</b>
                            @if (price.Cut is > 0)
                            {
                                <span class="price-cut">−@price.Cut%</span>
                            }
                        </div>
                        <dl class="mini-facts">
                            @if (price.Shop is { } shop)
                            {
                                <dt>At</dt><dd>@if (price.Url is { } shopUrl) { <a href="@shopUrl" target="_blank" rel="noopener">@shop</a> } else { @shop }</dd>
                            }
                            @if (price.Regular is { } regular && regular != amount)
                            {
                                <dt>Regular</dt><dd>@Fmt.Money(regular, price.Currency)</dd>
                            }
                            @if (price.Low is { } low)
                            {
                                <dt>Lowest ever</dt><dd>@Fmt.Money(low, price.Currency)</dd>
                            }
                            @if (price.CheckedAt is { } checkedAt)
                            {
                                <dt>Checked</dt><dd>@Fmt.Ago(checkedAt)</dd>
                            }
                        </dl>
                    }
                    else
                    {
                        <p class="muted small-empty">@(price?.CheckedAt is null ? "Prices are checked once a day (with an IsThereAnyDeal key in Ludex's .env)." : "Not sold in the PC stores IsThereAnyDeal follows.")</p>
                    }
                    <label class="price-target">
                        <span>Alert me under</span>
                        <input type="number" inputmode="decimal" min="0" max="1000" step="0.01" value="@(price?.Target?.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))" placeholder="—" data-price-target />
                        <button type="button" class="btn small soft" data-price-save>Save</button>
                    </label>
                </section>
            }

            @if (mine is not null)
            {
                <section class="side-card">
                    <h2 class="side-head">Your playtime</h2>
                    <div class="playtime"><b class="num">@(mine.Hours is { } ph ? Fmt.Hours(ph).Replace(" h", string.Empty) : "—")</b><span class="muted">hours on record</span></div>
                    @if (mine.RecentHours is { } recent)
                    {
                        <p class="recent-line">@Icons.Get("clock")@Fmt.Hours(recent) in the last 2 weeks</p>
                    }
                    <dl class="mini-facts">
                        <dt>Added</dt><dd>@Fmt.ShortDate(mine.AddedAt)</dd>
                        @if (mine.FinishedAt is { } finished)
                        {
                            <dt>Finished</dt><dd>@Fmt.ShortDate(finished)</dd>
                        }
                        <dt>Last changed</dt><dd>@Fmt.Ago(mine.UpdatedAt)</dd>
                        @if (mine.Platform is { } on)
                        {
                            <dt>Played on</dt><dd>@on</dd>
                        }
                        @if (copyNow is not null)
                        {
                            <dt>@(mine.Store is null ? "Copy" : "Bought on")</dt><dd>@copyNow</dd>
                        }
                    </dl>
                </section>
                <form method="post" action="/games/@game.Id/remove?entry=@mine.EntryId" class="remove" data-remove-game="@game.Id" data-remove-entry="@mine.EntryId" data-name="@game.Name@(mine.Copies.Count > 1 ? $" ({mine.Platform ?? "copy"})" : string.Empty)"
                      data-confirm="@(mine.Copies.Count > 1 ? $"Take this copy of {game.Name} ({mine.Platform ?? "no platform"}) out of your library? Its rating, hours and notes go too; your other copies stay." : $"Take {game.Name} out of your library? Its rating, hours and notes go too.")">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="link-btn danger">@Icons.Get("trash")@(mine.Copies.Count > 1 ? "Remove this copy" : "Remove from library")</button>
                </form>
            }
        </aside>
    </div>
</article>
</div>
</div>

<dialog class="lightbox" data-lightbox aria-label="Screenshot">
    <form method="dialog"><button class="icon-btn close" aria-label="Close">@Icons.Get("x")</button></form>
    <img alt="" />
</dialog>
