@model SteamGameDTO
@{
    var g = Model;
    var inLibrary = g.Game.MyStatus is not null;
    var sub = new List<string> { g.Hours > 0 ? $"{Fmt.Hours(g.Hours)} on Steam" : "Never played" };
    if (g.LastPlayedAt is { } last) { sub.Add("last played " + Fmt.Ago(last)); }
    if (g.RecentHours > 0) { sub.Add($"{Fmt.Hours(g.RecentHours)} in the last 2 weeks"); }
    var upToDate = inLibrary && g.Hours <= (g.LibraryHours ?? 0m);
    var playedAt = g.LastPlayedAt?.ToString("o", System.Globalization.CultureInfo.InvariantCulture);
}
<li class="steam-row@(upToDate ? " is-done" : string.Empty)" data-steam-row data-game="@g.Game.Id" data-hours="@Fmt.Input(g.Hours)" data-played="@playedAt" data-minutes-played="@(g.Hours > 0 ? "1" : "0")">
    <label class="steam-check">
        <input type="checkbox" checked="@(g.Selected ? "checked" : null)" disabled="@(upToDate ? "disabled" : null)" aria-label="Import @g.Game.Name" />
    </label>
    <span class="steam-cover"><partial name="_Cover" model='new CoverView(g.Game, "none")' /></span>
    <span class="steam-text">
        <b>@g.Game.Name</b>
        <small>@string.Join(" · ", sub)</small>
    </span>
    @if (inLibrary)
    {
        <span class="steam-state">
            <partial name="_StatusChip" model="g.Game.MyStatus!.Value" />
            <small class="muted">@(upToDate ? "Up to date" : $"{Fmt.Hours(g.LibraryHours)} → {Fmt.Hours(g.Hours)}")</small>
        </span>
    }
    else
    {
        <select class="steam-status" aria-label="Status for @g.Game.Name">
            @foreach (var s in new[] { GameStatus.Playing, GameStatus.Finished, GameStatus.Backlog, GameStatus.Dropped, GameStatus.Wishlist })
            {
                <option value="@s" selected="@(s == g.SuggestedStatus ? "selected" : null)">@Fmt.Status(s)</option>
            }
        </select>
    }
</li>
